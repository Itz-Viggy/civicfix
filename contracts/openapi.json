  "components": {
    "schemas": {
      "AnalysisView": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "classifier": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ClassifierExecution"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DescriptionExecution"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason_codes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reason Codes"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status",
          "classifier",
          "description",
          "reason_codes"
        ],
        "title": "AnalysisView"
      },
      "Analyze": {
        "properties": {
          "acknowledged": {
            "type": "boolean",
            "const": true,
            "title": "Acknowledged"
          },
          "disclosure_version": {
            "type": "string",
            "const": "local-v1",
            "title": "Disclosure Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "acknowledged",
          "disclosure_version"
        ],
        "title": "Analyze"
      },
      "Clarification": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "poor_image_quality",
              "no_supported_issue",
              "multiple_issues",
              "insufficient_visual_evidence",
              "operating_status_not_visible",
              "other_uncertainty"
            ],
            "title": "Code"
          },
          "detail": {
            "type": "string",
            "maxLength": 500,
            "title": "Detail",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code"
        ],
        "title": "Clarification"
      },
      "ClassifierExecution": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ClassifierResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StageError"
              },
              {
                "type": "null"
              }
            ]
          },
          "metadata": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "ClassifierExecution"
      },
      "ClassifierResult": {
        "properties": {
          "predicted_category": {
            "type": "string",
            "enum": [
              "pothole",
              "broken_streetlight",
              "damaged_sign",
              "leaking_hydrant",
              "illegal_dumping"
            ],
            "title": "Predicted Category"
          },
          "scores": {
            "additionalProperties": {
              "type": "number"
            },
            "propertyNames": {
              "enum": [
                "pothole",
                "broken_streetlight",
                "damaged_sign",
                "leaking_hydrant",
                "illegal_dumping"
              ]
            },
            "type": "object",
            "title": "Scores"
          },
          "top1_margin": {
            "type": "number",
            "minimum": 0.0,
            "title": "Top1 Margin"
          },
          "mode": {
            "type": "string",
            "const": "closed_set",
            "title": "Mode",
            "default": "closed_set"
          },
          "score_kind": {
            "type": "string",
            "const": "cosine_similarity",
            "title": "Score Kind",
            "default": "cosine_similarity"
          },
          "simulated": {
            "type": "boolean",
            "title": "Simulated",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "predicted_category",
          "scores",
          "top1_margin"
        ],
        "title": "ClassifierResult"
      },
      "Confirm": {
        "properties": {
          "confirmed": {
            "type": "boolean",
            "const": true,
            "title": "Confirmed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "confirmed"
        ],
        "title": "Confirm"
      },
      "DescriptionExecution": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DescriptionResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StageError"
              },
              {
