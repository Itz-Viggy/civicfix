{
  "generation": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "image_id",
      "run_id",
      "category_suggestion",
      "visible_observations",
      "description",
      "outcome",
      "clarification_reasons",
      "status",
      "error_status",
      "first_image_in_process",
      "identity_sha256",
      "generation_tokens",
      "prompt_tokens",
      "peak_memory_gb",
      "latency_seconds"
    ],
    "properties": {
      "image_id": {
        "type": "string",
        "minLength": 1
      },
      "run_id": {
        "type": "string",
        "minLength": 1
      },
      "category_suggestion": {
        "enum": [
          null,
          "pothole",
          "broken_streetlight",
          "damaged_sign",
          "leaking_hydrant",
          "illegal_dumping"
        ]
      },
      "visible_observations": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": {
        "type": "string"
      },
      "outcome": {
        "enum": [
          "supported",
          "unclear",
          "unsupported"
        ]
      },
      "clarification_reasons": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "status": {
        "enum": [
          "success",
          "error"
        ]
      },
      "error_status": {
        "type": [
          "string",
          "null"
        ]
      },
      "first_image_in_process": {
        "type": "boolean"
      },
      "identity_sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "generation_tokens": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0
      },
      "prompt_tokens": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0
      },
      "peak_memory_gb": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0
      },
      "latency_seconds": {
        "type": "number",
        "minimum": 0
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "success"
            }
          }
        },
        "then": {
          "properties": {
            "error_status": {
              "type": "null"
            }
          }
        },
        "else": {
          "properties": {
            "error_status": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "const": ""
            }
          }
        }
      }
    ]
  },
  "score": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "image_id",
      "run_id",
      "clip_cosine",
      "score_protocol",
      "status",
      "error_status",
      "token_occupancy"
    ],
    "properties": {
      "image_id": {
        "type": "string",
        "minLength": 1
      },
      "run_id": {
        "type": "string",
        "minLength": 1
      },
      "clip_cosine": {
        "type": [
          "number",
          "null"
        ],
        "minimum": -1,
        "maximum": 1
      },
      "score_protocol": {
        "const": "openclip-vit-b32-openai-native-raw-cosine-v1"
      },
      "status": {
        "enum": [
          "success",
          "skipped",
          "error"
        ]
      },
      "error_status": {
        "type": [
          "string",
          "null"
        ]
      },
      "token_occupancy": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0,
        "maximum": 77
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "success"
            }
          }
        },
        "then": {
          "properties": {
            "clip_cosine": {
              "type": "number"
            },
            "error_status": {
              "type": "null"
            },
            "token_occupancy": {
              "type": "integer"
            }
          }
        },
        "else": {
          "properties": {
            "clip_cosine": {
              "type": "null"
            },
            "error_status": {
              "type": "string"
            }
          }
        }
      }
    ]
  },
  "review": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "image_id",
      "run_id",
      "generation_sha256",
      "rubric_sha256",
      "unsupported_claim_count",
      "unsupported_claims",
      "clarity",
      "specificity",
      "missing_important_visible_fact",
      "notes",
      "reviewer"
    ],
    "properties": {
      "image_id": {
        "type": "string",
        "minLength": 1
      },
      "run_id": {
        "type": "string",
        "minLength": 1
      },
      "generation_sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "rubric_sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "unsupported_claim_count": {
        "type": "integer",
        "minimum": 0
      },
      "unsupported_claims": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "clarity": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2
      },
      "specificity": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2
      },
      "missing_important_visible_fact": {
        "type": "boolean"
      },
      "notes": {
        "type": "string",
        "minLength": 1
      },
      "reviewer": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "type",
          "method",
          "reviewed_utc"
        ],
        "properties": {
          "identity": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "agent_visual",
              "human"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_utc": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
